  "dispositions": {
    "V-01": {
      "ruling": "ADOPT",
      "grounds": "The named direct raw-admin composition cannot preserve administration; tighten PAO-CTL now and correct pins/runbook under P1, admitting only a separately approved authority-preserving GaugeAdder/wrapper composition, never a core admin-forwarder or raw-admin deployment.",
      "work_package": "P1",
      "lineage": [
        "L5/R07",
        "L6/PAO-CTL",
        "secgate §4 new composition prohibition"
      ]
    },
    "V-02": {
      "ruling": "ACCEPT-WITH-REASON",
      "grounds": "L1 → L2/V-I10 → L3/CGL-V-L03 → L4 §2.2 → L6/PAO-FD carry the shared-cursor custody choice; no-bounty removes reporter effects, not indefinite external contention or inter-listing serialization, so retain exact accounting with no completion bound or batch API.",
      "work_package": null,
      "lineage": [
        "L1",
        "L2/V-I10",
        "L3/CGL-V-L03",
        "L4 §2.2",
        "L6/PAO-FD",
        "secgate §3 current re-ratification"
      ]
    },
    "V-03": {
      "ruling": "ADOPT",
      "grounds": "L3/CGL-V-L02 and L4 reject new exit economics; P2 must explicitly disclose the potentially permanent whole-remainder lock from either immutable ingress failure or unusable FD, accepting that limit rather than adding refund/migration/partial payout/timeout seizure.",
      "work_package": "P2",
      "lineage": [
        "L3/CGL-V-L02",
        "L4 §2.2",
        "L5/R06",
        "secgate §5 permanent-FD acceptance"
      ]
    },
    "V-04": {
      "ruling": "ADOPT",
      "grounds": "Execution-time owner defaults are not payer-committed terms; P2 discloses the admission race and identity trust honestly, while an expected-config API/allowlist/timelock fails the current product's need gate and is not authorized by the narrower historical R17 rejection.",
      "work_package": "P2",
      "lineage": [
        "L4 §2.1",
        "L5/R17 comparison only, not exact precedent",
        "secgate §5 admission-consent adjudication"
      ]
    },
    "V-05": {
      "ruling": "ADOPT",
      "grounds": "L2/V-I11 and L6/C05 establish ingress-only evidence, not blanket V-M02 acceptance; P3 expressly accepts full-share loss without destination creation/local recredit and adds per-submission operational reconciliation, not a bridge acknowledgement/recovery protocol.",
      "work_package": "P3",
      "lineage": [
        "L2/V-I11",
        "L5/R16",
        "L6/C05",
        "secgate §5 explicit full-share non-delivery acceptance; not V-M02"
      ]
    },
    "V-06": {
      "ruling": "ACCEPT-WITH-REASON",
      "grounds": "L2/V-M02 → L3 §2 → L4 no-bounty carry expressly accept create-only residual forfeiture up to the full allocation; this gate re-ratifies that same exposure without reporter economics, L1-owner recovery claims or a manager/close API.",
      "work_package": null,
      "lineage": [
        "L2/V-M02",
        "L3 §2 V-M02 reaffirmation",
        "L4 residual disclosure",
        "secgate §3 current re-ratification"
      ]
    },
    "V-07": {
      "ruling": "ADOPT",
      "grounds": "L3/CGL-V-L06 accepts affordability as manager responsibility, not as V-M02; P3 binds the separate adapter authority and gas/value/backlog envelope for old routes, with no arbitrary on-chain cap or arithmetic-domain change.",
      "work_package": "P3",
      "lineage": [
        "L3/CGL-V-L06 §9",
        "L4 §2.3",
        "secgate §5 separate-role/pending-route application; not V-M02"
      ]
    },
    "V-08": {
      "ruling": "ACCEPT-WITH-REASON",
      "grounds": "L1 stale-refresh rule → L3/CGL-V-L03 → L4 §2.2 → L6/PAO-FD preserve the intentional floored-horizon guard independently of cooldown; retained escrow and execution-time zero-delta refresh remain the no-bounty policy.",
      "work_package": null,
      "lineage": [
        "L1 stale refresh",
        "L3/CGL-V-L03",
        "L4 §2.2",
        "L6/PAO-FD",
        "secgate §3 current re-ratification"
      ]
    },
    "I-01": {
      "ruling": "ACCEPT-WITH-REASON",
      "grounds": "L4 §2.2 and L6/C12/O-15 already distinguish maintenance return telemetry from `EscrowConfiscated`; the public ABI/runbook are truthful, so no new event or redundant documentation task is needed.",
      "work_package": null,
      "lineage": [
        "L4 §2.2",
        "L6/C12/O-15"
      ]
    },
    "I-02": {
      "ruling": "REJECT",
      "grounds": "L5/R18 and L6's sealed approval law retain zero-first/exact/clear compatibility; eliminating the positive approval's pre-zero has no demonstrated token-specific need and changes external call behavior.",
      "work_package": null,
      "lineage": [
        "L5/R18",
        "L6 sealed approvals"
      ]
    },
    "I-03": {
      "ruling": "ACCEPT-WITH-REASON",
      "grounds": "L6/C06 and O-09 explicitly retain the zero compatibility field/stride with derived getters/event receipts; this is the admitted representation, not missing storage to restore.",
      "work_package": null,
      "lineage": [
        "L6/C06/O-09"
      ]
    },
    "I-04": {
      "ruling": "ACCEPT-WITH-REASON",
      "grounds": "L4 §§2.1–2.3 and L6/O-08 preserve zero-share no-read/no-call behavior; an unused snapshot address is not venue identity, and consumers must apply the stored split before interpreting it.",
      "work_package": null,
      "lineage": [
        "L4 §§2.1–2.3",
        "L6/O-08"
      ]
    },
    "I-05": {
      "ruling": "ADOPT",
      "grounds": "P4 adds the cheap missing ABI-reader distinction: Active killed means zero, unreadable kill flag means a failed view, not zero or successful readiness; no scheduler or view-code change.",
      "work_package": "P4",
      "lineage": [
        "L4 flag-read law",
        "secgate P4"
      ]
    },
    "I-06": {
      "ruling": "ACCEPT-WITH-REASON",
      "grounds": "L8 explicitly placed test-only mocks under `contracts/mocks`, L4 §3 retained them and L6/O-14 excludes fixture authority; reconfirm exclusion from the three-product deployment allowlist, not relocation or a new census.",
      "work_package": null,
      "lineage": [
        "L8",
        "L4 §3",
        "L6/O-14; C16 fixture-interface-only comparison"
      ]
    },
    "I-07": {
      "ruling": "ADOPT",
      "grounds": "P4 documents that `BadAdmissionConfig` also covers a successfully decoded constructor decimals value other than 18; diagnosis uses call context, not a new selector or normalization of dependency failures.",
      "work_package": "P4",
      "lineage": [
        "L5/R21 diagnostic boundary",
        "secgate P4"
      ]
    }
  },
